# SERVIDOR
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=cambiar-por-una-clave-larga-y-unica-por-cliente

# Contraseña del usuario "admin" que se crea en el primer arranque.
# Cambiarla aquí después no modifica un admin que ya existe.
ADMIN_PASSWORD=cambiar-esta-clave

# DATOS DEL CLIENTE (bases de datos, FacInve.DBF y comprobantes)
# Carpeta fuera del código, por ejemplo C:/POS_datos. Vacío = carpeta backend/
DATA_DIR=

# RESPALDOS: se hace uno automático por día. Vacío = carpeta "respaldos" junto
# a los datos. Lo ideal es otro disco o una USB, por ejemplo E:/POS_respaldos
BACKUP_DIR=

# DATOS DEL NEGOCIO (salen impresos en el tiquete)
NOMBRE_COMERCIAL=Mi Negocio S.A.
CEDULA_EMISOR=3101234567
DIRECCION_EXACTA=San José, Costa Rica
TELEFONO=
